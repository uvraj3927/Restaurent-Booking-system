# Pyrites Grill Backend Environment Variables

FLASK_APP=app.py
FLASK_ENV=development
PORT=5000

# Database Configuration (MySQL Amazon RDS or Local SQLite for testing)
# MySQL syntax: mysql+pymysql://<db_user>:<db_password>@<rds_endpoint>:3306/<db_name>
# For local development without MySQL: sqlite:///pyrites_grill.db
DATABASE_URL=sqlite:///pyrites_grill.db

# Admin Secret Key for API protection
ADMIN_API_KEY=pg-admin-secret-key-123

# App Secret Key
SECRET_KEY=pyrites-grill-super-secret-key-2026
